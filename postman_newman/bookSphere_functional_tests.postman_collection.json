			"item": [
				{
					"name": "Register Alice (USA)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response contains token and userId\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token).to.exist;",
									"    pm.expect(jsonData.userId).to.exist;",
									"    pm.expect(jsonData.username).to.eql(pm.collectionVariables.get('alice_username'));",
									"    ",
									"    pm.collectionVariables.set('alice_token', jsonData.token);",
									"    pm.collectionVariables.set('alice_userId', jsonData.userId);",
